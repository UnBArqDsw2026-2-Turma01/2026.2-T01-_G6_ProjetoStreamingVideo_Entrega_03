@startuml factory-method-classes-v1
!pragma layout smetana
title Factory Method aplicado a UserContent — diagrama de classes

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam class {
  BackgroundColor<<Product>> #DAE8FC
  BackgroundColor<<ConcreteProduct>> #DAE8FC
  BackgroundColor<<Creator>> #FFE6CC
  BackgroundColor<<ConcreteCreator>> #FFE6CC
  BackgroundColor<<Client>> #E1D5E7
  BackgroundColor<<Existente>> #F5F5F5
  BackgroundColor<<Error>> #F8CECC
}
hide empty members

class "registrar(creator, input)" as Client <<Client>>

interface ContentRepository <<Existente>> {
  + save(content: UserContent): void
  + findContentById(contentId: UUID): UserContent [0..1]
  + findRecordingByStream(streamId: UUID): RecordedVideo [0..1]
}

interface PolicyService <<Existente>> {
  + moderate(contentId: UUID): ModerationResult
}

abstract class "UserContentCreator<TInput, TContent>" as UserContentCreator <<Creator>> {
  # {readonly} repository: ContentRepository
  - {readonly} policy: PolicyService
  + UserContentCreator(dependencies: CreatorDependencies)
  + submit(input: TInput): TContent
  # {abstract} createContent(input: TInput): TContent
  # nextId(): string
  # currentTime(): Date
}

class "StreamConfig" as StreamConfig <<Existente>> {
  produto do Builder (ADR-001)
}

class ClipRequestInput <<value object>> {
  + {readonly} requestedByUserId: UUID
  + {readonly} sourceStreamId: UUID
  + {readonly} startOffsetSeconds: Real
  + {readonly} endOffsetSeconds: Real
  + {readonly} title: string
}

class LiveStreamCreator <<ConcreteCreator>> {
  # createContent(input: LiveStreamInput): LiveStream
}
class RecordedVideoCreator <<ConcreteCreator>> {
  # createContent(input: RecordingInput): RecordedVideo
}
class ClipCreator <<ConcreteCreator>> {
  # createContent(input: ClipRequestInput): Clip
}

class LiveStream <<ConcreteProduct>> {
  + {readonly} channelId: UUID
  + {readonly} latencyMode: LatencyMode
  + {readonly} recordAutomatically: boolean
  + {readonly} status: LiveStreamStatus
  + {readonly} startedAt: Date [0..1]
  + {readonly} endedAt: Date [0..1]
  + {readonly} failureReason: string [0..1]
  + markLive(at: Date = now()): void
  + finish(at: Date = now()): void
  + fail(reason: string): void
}

class RecordedVideo <<ConcreteProduct>> {
  + {readonly} sourceStreamId: UUID
  + {readonly} processingStatus: ProcessingStatus
  + {readonly} durationSeconds: Real [0..1]
  + {readonly} storageUri: string [0..1]
  + {readonly} availableAt: Date [0..1]
  + {readonly} viewCount: Integer
  + markReady(ready: RecordingReadyFields): void
  + markFailed(): void
  + isReady(): boolean
  + incrementViewCount(): void
}

class Clip <<ConcreteProduct>> {
  + {readonly} sourceVideoId: UUID
  + {readonly} createdByUserId: UUID
  + {readonly} startOffsetSeconds: Real
  + {readonly} endOffsetSeconds: Real
  + {readonly} /durationSeconds: Real
}

abstract class UserContent <<Product>> {
  + {readonly} id: UUID
  + {readonly} ownerId: UUID
  + {readonly} title: string
  + {readonly} visibility: ContentVisibility
  + {readonly} createdAt: Date
  + {readonly} publicationStatus: PublicationStatus
  + {readonly} moderationStatus: ModerationResult
  + {abstract} isMediaReady(): boolean
  + applyModeration(result: ModerationResult): void
  + publish(): void
  + unpublish(): void
  + isPublished(): boolean
}

class ContentRuleViolationError <<Error>> {
  + {readonly} rule: F1..F6
}

class Error <<Existente>>

' Grade: Creator e Product no topo; cada ConcreteCreator na mesma linha do produto que cria
UserContentCreator .right.> UserContent : submit() usa
Client ..> UserContentCreator : usa só o Creator
Client ..> UserContent : enxerga só o Product
UserContentCreator -left-> ContentRepository : repository
UserContentCreator -left-> PolicyService : policy
ContentRepository -[hidden]down- PolicyService

UserContentCreator <|-- LiveStreamCreator
UserContentCreator <|-- RecordedVideoCreator
UserContentCreator <|-- ClipCreator
LiveStreamCreator -[hidden]down- RecordedVideoCreator
RecordedVideoCreator -[hidden]down- ClipCreator

UserContent <|-- LiveStream
UserContent <|-- RecordedVideo
UserContent <|-- Clip
LiveStream -[hidden]down- RecordedVideo
RecordedVideo -[hidden]down- Clip

LiveStreamCreator .right.> LiveStream : <<create>>
RecordedVideoCreator .right.> RecordedVideo : <<create>>
ClipCreator .right.> Clip : <<create>>

StreamConfig <.left. LiveStreamCreator : entrada\n(LiveStreamInput.config)
ClipCreator .left.> ClipRequestInput : entrada

RecordedVideo .up.> LiveStream : origem no construtor\n(guarda só o id)
Clip .up.> RecordedVideo : origem no construtor\n(guarda só o id)

UserContent .right.> ContentRuleViolationError : <<throws>>
RecordedVideoCreator ..> ContentRuleViolationError : <<throws>> F2
ClipCreator ..> ContentRuleViolationError : <<throws>> F4
ContentRuleViolationError -down-|> Error

note left of UserContentCreator
  submit(input):
  1. content = createContent(input)  ← método-fábrica
  2. repository.save(content)
  3. content.applyModeration(policy.moderate(content.id))
  4. se APPROVED e isMediaReady(): content.publish()   (F6)
  5. repository.save(content)
end note

note right of Clip
  F4 origem READY · F5 0 ≤ início < fim ≤ duração
  dono = dono da gravação (regra 7 do v3)
end note

note right of RecordedVideo
  F2 origem ENDED com gravação automática;
     uma gravação por transmissão (RecordedVideoCreator)
  F3 READY exige duração, storageUri e availableAt válidos
end note

note right of LiveStream
  finish() e fail() despublicam (F6 vale
  enquanto o conteúdo está publicado)
end note
@enduml
